#!/bin/bash

VAULT_DIR="${HOME}/.local/share/vault"
VAULT_VERSION="0.7"

[[ ! -d "$VAULT_DIR" ]] && mkdir -p "$VAULT_DIR"/{config,prefix_tree}
[[ ! -d "$HOME/.local/bin" ]] && mkdir -p "$HOME"/.local/bin
[[ ! -f "$VAULT_DIR/vault" ]] && cp "$(pwd)/vault" "$VAULT_DIR/" && chmod +x "$VAULT_DIR/vault"
[[ ! -f "$HOME/.local/bin/vault" ]] && ln -sf "$VAULT_DIR/vault" "$HOME/.local/bin/vault"

function launchGame(){
	(
		if [[ ! $(ls "$VAULT_DIR/config") ]]; then
			printf "No games have been added yet, add them with: vault --add\n"
		else
			while true; do
				clear
				printf "List of games added:\n\n$(ls "$VAULT_DIR/config")\n\n"
				cd "$VAULT_DIR"/config
				read -e -p "$ " launchGameSelection
				if [[ ! -f "$VAULT_DIR/config/$launchGameSelection" ]]; then
				        printf "\e[1;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
				else
					source "$VAULT_DIR/config/$launchGameSelection"
					printf "\e[1;93mWait...\e[0m\n"
					sleep 1.5
					if [[ $NATIVE_RUNNER == 1 ]]; then
						chmod +x "$EXEC"
						"$EXEC"
					else
						WINEPREFIX="$PREFIX" wine "$EXEC"
						wineserver -w
					fi
					sleep 1.5
					printf "\n\e[1;92mDone!\e[0m\n"
					break			
				fi
			done
		fi
	)
}

function cfgGamePFX(){
	(
		while true; do
			if [[ ! $(ls "$VAULT_DIR/config") ]]; then
				printf "No games available for removal.\n" && break
			else
				clear
				printf "List of games added:\n"
				printf "\n$(ls "$VAULT_DIR/config")\n\n"	
				cd "$VAULT_DIR"/config
				read -e -p "Prefix name for maintenance: " maintGameName
				if [[ "$maintGameName" == ":q" ]]; then
					exit
				elif [[ ! -f "$VAULT_DIR/config/$maintGameName" ]]; then
					printf "\e[1;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
				else
					source "$maintGameName"
					if [[ -z "$PREFIX" || "$PREFIX" == "$maintGameName" ]]; then
						printf "\e[1;91mERROR:\e[0m '$maintGameName' is a Native game and doesn't have a WINEPREFIX.\n"
						sleep 2.5
					else
						export WINEPREFIX="$PREFIX" && printf "\n\e[1mActive Prefix: $maintGameName ($PREFIX)\n\e[0m\nAny command involving wine/winetricks typed in this shell will be executed exclusively on the prefix selected later.\nTo continue after this, simply type: exit\n\n" && bash
						printf "\e[1;92mEXIT_SUCCESS\e[0m\n" && break
					fi
				fi
			fi
		done
	)
}

function addGame(){
	while true; do
		clear
		read -p "Name: " addGameName
		read -e -p "Exec: " addGameExec
		while true; do
			read -p "Native/Wine: " addGameArq
			if [[ "$addGameArq" == "Native" || "$addGameArq" == "native" || "$addGameArq" == "Wine" || "$addGameArq" == "wine" ]]; then
				break 1
			else
				printf "\e[1;91mERROR:\e[0m Invalid option.\n" && sleep 1.5
				clear && printf "Name: $addGameName\nExec: $addGameExec\n"
			fi
		done
		if [[ -z "$addGameName" || -z "$addGameExec" || -z "$addGameArq" ]]; then
			printf "\e[1;91mERROR:\e[0m Empty value.\n" && sleep 1.5
		elif [[ "$addGameArq" == "Native" || "$addGameArq" == "native" || "$addGameArq" == "n" ]]; then
			(
				cd "$VAULT_DIR/config"
				echo "NAME='$addGameName'" > "$addGameName"
				echo "EXEC='$addGameExec'" >> "$addGameName"
				echo "NATIVE_RUNNER='1'" >> "$addGameName"
			)
			break
		elif [[ "$addGameArq" == "Wine" || "$addGameArq" == "wine" || "$addGameArq" == "w" ]]; then
		 	(
				cd "$VAULT_DIR"/config
				echo "NAME='$addGameName'" > "$addGameName"
				echo "EXEC='$addGameExec'" >> "$addGameName"
				echo "PREFIX='$VAULT_DIR/prefix_tree/$addGameName'" >> "$addGameName"
				mkdir -p "$VAULT_DIR/prefix_tree/$addGameName"
			)
			break
		fi
	done
}

function delGame(){
	(
		while true; do
			if [[ ! $(ls "$VAULT_DIR/config") ]]; then
				printf "No games available for removal.\n" && break
			else
				clear
				printf "List of games added:\n"
				printf "\n$(ls "$VAULT_DIR/config")\n\n"	
				cd "$VAULT_DIR"/config
				read -e -p "Name of the game to be removed: " delGameName
				if [[ ! -f "$VAULT_DIR/config/$delGameName" ]]; then
					printf "\e[1;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
				else
					while true; do
						clear
						printf "Do you really want to remove the $delGameName?\n\n"
						read -p "[Y/n] " delGameConfirm
						[[ -z "$delGameConfirm" ]] && delGameConfirm="y"
						if [[ $delGameConfirm == "Y" || $delGameConfirm == "y" ]]; then
							rm -rf "$VAULT_DIR/prefix_tree/$delGameName"
							rm -f "$VAULT_DIR/config/$delGameName"
							break 2
						elif [[ $delGameConfirm == "N" || $delGameConfirm == "n" ]]; then
							break
						else
							printf "\e[1;91mERROR:\e[0m Invalid option.\n"
							sleep 1.5
						fi
					done
				fi
			fi
		done
	)
}

case $1 in
	"--list")
		if [[ ! $(ls "$VAULT_DIR/config") ]]; then
			printf "No games added.\n" && exit
		else
			printf "\n$(ls "$VAULT_DIR/config")\n\n"
		fi
	;;
	"--update")
		[[ ! -d "$VAULT_DIR" ]] && mkdir -p "$VAULT_DIR"
		cp -r "$(pwd)/vault" "$VAULT_DIR/"
	;;
	"--launch")
		launchGame
	;;
	"--configure-prefix")
		cfgGamePFX
	;;
	"--add")
		addGame
	;;
	"--del")
		delGame
	;;
	"--version")
		printf "vault-$VAULT_VERSION\n"
	;;
	*)
		printf "\nY88b      /                    888   d8	\n"   
		printf " Y88b    /    /~~~8e  888  888 888 _d88__\n"
		printf "  Y88b  /         88b 888  888 888  888  \n"
		printf "   Y888/     e88~-888 888  888 888  888  \n"
		printf "    Y8/     C888  888 888  888 888  888  \n"
		printf '     Y       "88_-888 "88_-888 888  "88_/\n\n'
		printf "%-30s %0s\n" "vault --version" "Show vault version."
		printf "%-30s %0s\n\n" "vault --update" "Update the vault binaries locally."
		printf "%-30s %0s\n" "vault" "Show this message."
		printf "%-30s %0s\n" "vault --list" "List of added games."
		printf "%-30s %0s\n" "vault --launch" "Launch a game."
		printf "%-30s %0s\n" "vault --add" "Add a new game."
		printf "%-30s %0s\n" "vault --del" "Remove a game."
		printf "%-30s %0s\n\n" "vault --configure-prefix" "Opens a subshell with the prefix set for easy maintenance."
	;;
esac
