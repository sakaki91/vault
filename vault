#!/bin/bash
#NOTES: adicionar o read -e na selecao (adicao e subtracao) dos jogos para autocompletar usando o BASH

VAULT_DIR=$(pwd)
VAULT_VERSION="0.1-beta"

[[ ! -f "$VAULT_DIR/.logo" ]] && curl -Os https://raw.githubusercontent.com/sakaki91/vault/refs/heads/main/.logo
[[ ! -d "$HOME/.local/bin" ]] && mkdir -p "$HOME/.local/bin"
[[ ! -f "$HOME/.local/bin/vault" ]] && ln -sf $(pwd)/vault "$HOME/.local/bin/vault"

function launchGame(){
	while true; do
		printf "List of games added:\n\n$(ls "$VAULT_DIR/config")\n\n"
		read -p "$ " launchGameSelection
		[[ ! -f "$VAULT_DIR/config/$launchGameSelection" ]] && printf "\e[1;91mERROR:\e[0m Invalid Option.\n" && sleep 1.5 && clear
		source "$VAULT_DIR/config/$launchGameSelection"
		WINEPREFIX="$PREFIX" wine "$EXEC"
		wineserver -w
		sleep 1.5
		printf "\nDone!\n"
		break
	done
}

function addGame(){
	[[ ! -d "$VAULT_DIR"/{config,prefix_tree} ]] && mkdir -p "$VAULT_DIR"/{config,prefix_tree}
	read -p "Name: " addGameName
	read -p "Exec: " addGameExec
	[[ -z "$addGameName" ]] && printf "\e[1;91mERROR:\e[0m Empty value.\n" && exit
	(
		cd "$VAULT_DIR"/config
		echo "NAME='$addGameName'" > "$addGameName"
		echo "EXEC='$addGameExec'" >> "$addGameName"
		echo "PREFIX='$VAULT_DIR/prefix_tree/$addGameName'" >> "$addGameName"
	)
	mkdir -p "$VAULT_DIR/prefix_tree/$addGameName"
}

function delGame(){
	while true; do
		clear
		printf "List of games added:\n"
		printf "\n$(ls "$VAULT_DIR/prefix_tree")\n\n"
		read -p "Name of the game to be removed: " delGameName
		[[ ! -f "$VAULT_DIR/config/$delGameName" || ! -d "$VAULT_DIR/prefix_tree/$delGameName" ]] && printf "\e[1;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5 && exit
		clear
		printf "Do you really want to remove the $delGameName?\n\n"
		read -p "[Y/n] " delGameConfirm
		if [[ $delGameConfirm == "Y" || $delGameConfirm == "y" ]]; then
			rm -rf "$VAULT_DIR/prefix_tree/$delGameName"
			rm -f "$VAULT_DIR/config/$delGameName"
			break
		elif [[ $delGameConfirm == "N" || $delGameConfirm == "n" ]]; then
			break
		else
			printf "\e[1;91mERROR:\e[0m Invalid option.\n"
			sleep 1.5
		fi
	done
}

case $1 in
	"--list")
		ls "$VAULT_DIR/prefix_tree"
	;;
	"--launch")
		launchGame
	;;
	"--add")
		addGame
	;;
	"--del")
		delGame
	;;
	"--help")
		cat "$VAULT_DIR"/.logo
		printf "%-20s %0s\n" "vault --help" "Show this message."
		printf "%-20s %0s\n\n" "vault --version" "Show vault version."
		printf "%-20s %0s\n" "vault --list" "List of added games."
		printf "%-20s %0s\n" "vault --launch" "The game runs based on its respective name."
		printf "%-20s %0s\n" "vault --add" "Add a new game."
		printf "%-20s %0s\n\n" "vault --del" "Remove a game."
	;;
	"--version")
		printf "vault-$VAULT_VERSION\n"
	;;
	*)
		printf "\e[1;91mERROR:\e[0m Invalid option.\n"
	;;
esac
