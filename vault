#!/bin/bash

VAULT_DIR="${HOME}/.local/share/vault"
VAULT_VERSION="1.3"

[[ ! -d "$VAULT_DIR" ]] && mkdir -p "$VAULT_DIR"/{config,prefix_tree}
[[ ! -d "$HOME/.local/bin" ]] && mkdir -p "$HOME"/.local/bin
[[ ! -f "$VAULT_DIR/vault" ]] && cp "$(pwd)/vault" "$VAULT_DIR/" && chmod +x "$VAULT_DIR/vault"
[[ ! -f "$HOME/.local/bin/vault" ]] && ln -sf "$VAULT_DIR/vault" "$HOME/.local/bin/vault"

function binList(){
    if [[ ! $(ls "$VAULT_DIR/config") ]]; then
		printf "No binaries have been added yet. Add them with: vault --add\n"
	else
		printf "\e[1mList of added binaries:\e[0m\n\n$(ls "$VAULT_DIR/config")\n\n"
		cd "$VAULT_DIR"/config
    fi
}

function selectBin(){
	(
		while true; do
			clear
			binList
			read -e -p "> " launchBinSelection
			if [[ -z $launchBinSelection ]]; then
				printf "\e[0;91mERROR:\e[0m Empty value.\n" && sleep 1.5
			elif [[ ! -f "$VAULT_DIR/config/$launchBinSelection" ]]; then
				printf "\e[0;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
			else
				source "$VAULT_DIR/config/$launchBinSelection"
				runBin
				break
			fi
		done
	)
}

function runBin(){
	if [[ $NATIVE_RUNNER == 1 ]]; then
		chmod +x "$EXEC"
		"$EXEC"
	else
		WINEPREFIX="$PREFIX" wine "$EXEC"
		wineserver -w
	fi
	sleep 1.5
	printf "\n\e[0;92mDone!\e[0m\n"
}

function cfgBinPFX(){
	(
	    while true; do
			clear
    	    binList
    	    printf "Prefix name for \e[0;93mmaintenance:\e[0m" && read -e -p " " mainBinName
            if [[ -z $mainBinName ]]; then
                printf "\e[0;91mERROR:\e[0m Empty value.\n" && sleep 1.5
            elif [[ ! -f "$VAULT_DIR/config/$mainBinName" ]]; then
				printf "\e[0;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
			else
				source "$mainBinName"
				if [[ -z "$PREFIX" || "$PREFIX" == "$mainBinName" ]]; then
					printf "\e[0;91mERROR:\e[0m '$mainBinName' is a Native binary, and doesn't have a WINEPREFIX.\n"
					sleep 2.5
				else
					export WINEPREFIX="$PREFIX" && printf "\n\e[1mActive Prefix: $mainBinName ($PREFIX)\n\e[0m\nAny command involving wine/winetricks typed in this shell will be executed exclusively on the prefix selected later.\nTo continue after this, simply type: exit\n\n" && bash
					printf "\e[0;92mEXIT_SUCCESS\e[0m\n" && break
				fi
			fi
		done
	)
}

function editBin(){
	(
		while true; do
		    clear
		    binList
			printf "Binary name to \e[0;93medit:\e[0m" && read -e -p " " editBinName
			if [[ -z $editBinName ]]; then
			    printf "\e[0;91mERROR:\e[0m Empty value.\n" && sleep 1.5
			elif [[ ! -f "$editBinName" ]]; then
				printf "\e[0;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
			else
			    [[ ! $(command -v vi) ]] && printf "\e[0;91mERROR:\033[0m vi is not installed, install it and try again.\n" && exit
				vi "$VAULT_DIR/config/$editBinName"
				printf "\e[0;92mEXIT_SUCCESS\e[0m\n"
				break
			fi
		done
	)
}

function addBin(){
    (
    	while true; do
    		clear
    		printf "\e[1mvault-$VAULT_VERSION\e[0m\n\n"
    		read -p "Binary name: " addBinName && [[ -z "$addBinName" ]] && printf "\e[0;91mERROR:\e[0m Empty value.\n" && exit
    		read -e -p "Binary path: " addBinExec && [[ -z "$addBinExec" ]] && printf "\e[0;91mERROR:\e[0m Empty value.\n" && exit
    		read -p "[native/wine]: " addBinArq && [[ -z "$addBinArq" ]] && printf "\e[0;91mERROR:\e[0m Empty value.\n" && exit
            cd "$VAULT_DIR/config"
    		echo "NAME='$addBinName'" > "$addBinName"
    		echo "EXEC='$addBinExec'" >> "$addBinName"
    		if [[ $addBinArq == "Native" || $addBinArq == "native" || $addBinArq == "n" ]]; then
    			echo "NATIVE_RUNNER='1'" >> "$addBinName"
    			break
    		elif [[ $addBinArq == "Wine" || $addBinArq == "wine" || $addBinArq == "w" ]]; then
    			echo "PREFIX='$VAULT_DIR/prefix_tree/$addBinName'" >> "$addBinName"
    			mkdir -p "$VAULT_DIR/prefix_tree/$addBinName"
    			break
    		else
    		    printf "\e[0;91mERROR:\e[0m Invalid option.\n" && sleep 1.5
    		fi
    	done
	)
}

function delBin(){
	(
		while true; do
		    clear
		    binList
			printf "Binary name to \e[0;91mremove:\e[0m" && read -e -p " " delBinName
			if [[ -z $delBinName ]]; then
			    printf "\e[0;91mERROR:\e[0m Empty value.\n" && sleep 1.5
            elif [[ ! -f "$VAULT_DIR/config/$delBinName" ]]; then
				printf "\e[0;91mERROR:\e[0m This option doesn't exist.\n" && sleep 1.5
			else
    			while true; do
    				clear
    				printf "Do you really want to remove the \e[1m$delBinName\e[0m?\n\n"
    				read -p "[Y/n] " delBinConfirm
    				[[ -z "$delBinConfirm" ]] && delBinConfirm="y"
    				if [[ $delBinConfirm == "Y" || $delBinConfirm == "y" ]]; then
    					rm -rf "$VAULT_DIR/prefix_tree/$delBinName"
    					rm -f "$VAULT_DIR/config/$delBinName"
    					break 2
    				elif [[ $delBinConfirm == "N" || $delBinConfirm == "n" ]]; then
    					break
    				else
    					printf "\e[0;91mERROR:\e[0m Invalid option.\n"
    					sleep 1.5
    				fi
    			done
			fi
		done
	)
}

case $1 in
	"--version")
		printf "vault-$VAULT_VERSION\n"
	;;
	"--dir")
		xdg-open "$HOME/.local/share/vault" &>> /dev/null
 	    printf "If nothing happens, go to: \e[1m$HOME/.local/share/vault\e[0m\n"
	;;
	"--list")
		binList
	;;
	"--launch")
		if [[ ! -z $2 ]]; then
			[[ ! -f "$VAULT_DIR/config/$2" ]] && printf "\e[0;91mERROR:\e[0m This option doesn't exist.\n" && exit
			source "$VAULT_DIR/config/$2"
			runBin
			exit
		else
			selectBin
		fi
	;;
	"--edit")
		editBin
	;;
	"--add")
		addBin
	;;
	"--del")
		delBin
	;;
	"--cfg-pfx")
		cfgBinPFX
	;;
	*)
		#The program's ASCII code is displayed on the first line; changing it may affect the user experience.
		printf '\nY88b      /                    888   d8	\n Y88b    /    /~~~8e  888  888 888 _d88__\n  Y88b  /         88b 888  888 888  888  \n   Y888/     e88~-888 888  888 888  888  \n    Y8/     C888  888 888  888 888  888  \n     Y       "88_-888 "88_-888 888  "88_/\n\n'
		printf "\e[1msystem:\e[0m\n %-20s %0s\n" "--version" "Show vault version."
		printf " %-20s %0s\n\n" "--dir" "Opens the local vault files."
		printf "\e[1mlaunch options:\e[0m\n %-20s %0s\n" "--launch" "Launch an added binary."
		printf " %-20s %0s\n\n" "--launch 'app'" "Launch a binary already added directly using \$2."
		printf "\e[1mfunctions:\e[0m\n %-20s %0s\n" "--list" "List the added binaries."
		printf " %-20s %0s\n" "--edit" "Edits an added binary."
		printf " %-20s %0s\n" "--add" "Adds a new binary."
		printf " %-20s %0s\n" "--del" "Remove a binary."
		printf " %-20s %0s\n\n" "--cfg-pfx" "Opens a subshell with the prefix set for easy maintenance."
	;;
esac
