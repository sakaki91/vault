#!/bin/bash

VAULT_DIR="${HOME}/.local/share/vault"
VAULT_VERSION="1.5-2"

[[ ! -d "$VAULT_DIR/config" || ! -d "$VAULT_DIR/prefix_tree" ]] && mkdir -p "$VAULT_DIR"/{config,prefix_tree}

case $1 in
	"--version"|"-v")
		printf "vault-$VAULT_VERSION\n"
	;;
	"--dir")
		xdg-open "$HOME/.local/share/vault" &>> /dev/null
 	    printf "If nothing happens, go to: \e[1m$HOME/.local/share/vault\e[0m\n"
	;;
	"--list")
		[[ ! $(ls "$VAULT_DIR/config") ]] && printf "\e[0;91m::\e[0m No binaries have been added yet.\n\e[1mAdd them with:\e[0m vault --add 'name' 'path' 'native/wine'\e[0m\n" && exit
		printf "\e[1mList of added binaries:\e[0m\n\e[2m\e[1m$(ls "$VAULT_DIR/config")\e[0m\n"
	;;
	"--launch")
		[[ -z $2 ]] && printf "\e[0;91m::\e[0m Empty value.\n" && exit
		[[ ! -f "$VAULT_DIR/config/$2" ]] && printf "\e[0;91m::\e[0m Invalid option.\n" && exit
		source "$VAULT_DIR/config/$2"
		if [[ $NATIVE_RUNNER == 1 ]]; then
			chmod +x "$EXEC"
			"$EXEC" && printf "\e[0;92m:: \e[0mEXIT_SUCCESS\n"
		else
			[[ ! $(command -v wine) ]] && printf "\e[0;91m::\033[0m \e[1mwine\e[0m is not installed, install it and try again.\n" && exit
			WINEPREFIX="$PREFIX" wine "$EXEC"
			wineserver -w && sleep 2 && printf "\e[0;92m:: \e[0mEXIT_SUCCESS\n"
		fi
	;;
	"--edit")
		[[ -z $2 ]] && printf "\e[0;91m::\e[0m Empty value.\n" && exit
		[[ ! -f "$VAULT_DIR/config/$2" ]] && printf "\e[0;91m::\e[0m Invalid option.\n" && exit
		[[ ! $(command -v vi) ]] && printf "\e[0;91m::\033[0m \e[1mvi\e[0m is not installed, install it and try again.\n" && exit
		vi "$VAULT_DIR/config/$2"
		printf "\e[0;92m:: \e[0mEXIT_SUCCESS\n"
	;;
	"--add")
		if [[ -z $2 || -z $3 || -z $4 ]]; then
			printf "\e[0;91m::\e[0m Empty value.\n"
		else
			if [[ $4 == "native" || $4 == "n" || $4 == "wine" || $4 == "w" ]]; then
				echo "NAME='$2'" > "$VAULT_DIR/config/$2"
				echo "EXEC='$3'" >> "$VAULT_DIR/config/$2"
				[[ $4 == "native" || $4 == "n" ]] && echo "NATIVE_RUNNER='1'" >> "$VAULT_DIR/config/$2"
				[[ $4 == "wine" || $4 == "w" ]] && echo "PREFIX='$VAULT_DIR/prefix_tree/$2'" >> "$VAULT_DIR/config/$2" && mkdir -p "$VAULT_DIR/prefix_tree/$2"
			else
				printf "\e[0;91m::\e[0m Invalid runner type at \e[1m\$4\e[0m (try 'wine' or 'native').\n"
			fi
		fi
	;;
	"--del")
		[[ -z $2 ]] && printf "\e[0;91m::\e[0m Empty value.\n" && exit
		[[ ! -f "$VAULT_DIR/config/$2" ]] && printf "\e[0;91m::\e[0m Invalid option.\n" && exit
    	printf "Do you really want to remove the \e[1m'$2'\e[0m?\n"
    	read -p "[Y/n] " gameConfirmDel
    	[[ -z "$gameConfirmDel" ]] && gameConfirmDel="y"
    	if [[ $gameConfirmDel == "Y" || $gameConfirmDel == "y" ]]; then
			rm -rf "$VAULT_DIR/prefix_tree/$2"
			rm -f "$VAULT_DIR/config/$2"
			[[ ! -f "$VAULT_DIR/config/$2" || ! -d "$VAULT_DIR/prefix_tree" ]] && printf "\e[0;92m::\e[0m Binaries successfully removed!\n"
		elif [[ $gameConfirmDel == "N" || $gameConfirmDel == "n" ]]; then
			printf "\e[0;93m::\e[0m Cancelled by user.\n" 
    	else
    		printf "\e[0;91m::\e[0m Invalid option.\n"
    	fi		
	;;
	"--cfg-pfx")
		[[ -z $2 ]] && printf "\e[0;91m::\e[0m Empty value.\n" && exit
		[[ ! -f "$VAULT_DIR/config/$2" ]] && printf "\e[0;91m::\e[0m Invalid option.\n" && exit
		source "$VAULT_DIR/config/$2"
		if [[ -z "$PREFIX" ]]; then
			printf "\e[0;91m::\e[0m \e[3m\e[1m$2\e[0m is a native binary, and doesn't have a \e[1mWINEPREFIX\e[0m.\n" && exit
		else
			export WINEPREFIX="$PREFIX" && printf "\n\e[1mACTIVE WINEPREFIX :: \e[4m$2\e[0m >>> $PREFIX\n\e[0m\nAny command involving wine/winetricks typed in this shell will be executed exclusively on the prefix selected later.\nTo continue after this, simply type: \e[1mexit\e[0m\n\n" && bash
			printf "\e[0;92m:: \e[0mEXIT_SUCCESS\n"
		fi
	;;
	*)
		printf "\e[1msystem:\e[0m\n"
		printf "   %-25s %0s\n" "--version:" "Show vault version."
		printf "   %-25s %0s\n\n" "--dir" "Opens the local vault files."
		printf "\e[1mfunctions:\e[0m\n"
		printf "   %-25s %0s\n" "--list" "List the added binaries."
		printf "   %-25s %0s\n" "--launch 'app'" "Launch a binary already added directly using \$2."
		printf "   %-25s %0s\n" "--add" "Adds a new binary."
		printf "   %-25s %0s\n" "--del" "Remove a binary."
		printf "   %-25s %0s\n" "--edit" "Edits an added binary."
		printf "   %-25s %0s\n\n" "--cfg-pfx" "Opens a subshell with the prefix set for easy maintenance."
		printf "\e[1mexamples:\e[0m\n"
		printf "   %-12s %0s\n"  "--add" "'Rhythia' 'path to the executable' 'native/wine'"
		printf "   %-12s %0s\n" "--del" "'Rhythia'"
		printf "   %-12s %0s\n" "--edit" "'Rhythia'"
		printf "   %-12s %0s\n" "--cfg-pfx" "'Rhythia'"
		printf "   %-12s %0s\n\n" "--launch" "'Rhythia'"
	;;
esac
